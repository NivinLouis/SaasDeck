POSTGRES_DB=brightloop
POSTGRES_USER=brightloop_user
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://brightloop_user:change-me-for-local-development@db:5432/brightloop

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
DJANGO_LOG_LEVEL=INFO

# GST tax-invoice issuer profile. These are validated before a final tax invoice is rendered.
GST_INVOICE_SUPPLIER_LEGAL_NAME=
GST_INVOICE_SUPPLIER_ADDRESS=
GST_INVOICE_SUPPLIER_GSTIN=
GST_INVOICE_SUPPLIER_STATE_NAME=
GST_INVOICE_SUPPLIER_STATE_CODE=
GST_INVOICE_AUTHORISED_SIGNATORY=
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Billing jobs and invoice delivery. The default email backend writes messages
# to the backend logs; configure an SMTP backend before production use.
BILLING_RUN_HOUR=1
BILLING_RUN_MINUTE=0
OVERDUE_REMINDER_HOUR=9
INVOICE_PDF_ASYNC=True
INVOICE_EMAIL_ASYNC=True
DJANGO_DEFAULT_FROM_EMAIL=billing@example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP delivery, set DJANGO_EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and provide the host credentials below.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
