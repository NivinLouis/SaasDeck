POSTGRES_DB=brightloop
POSTGRES_USER=brightloop_user
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://brightloop_user:change-me-for-local-development@db:5432/brightloop

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# GST tax-invoice issuer profile. These are validated before a final tax invoice is rendered.
GST_INVOICE_SUPPLIER_LEGAL_NAME=
GST_INVOICE_SUPPLIER_ADDRESS=
GST_INVOICE_SUPPLIER_GSTIN=
GST_INVOICE_SUPPLIER_STATE_NAME=
GST_INVOICE_SUPPLIER_STATE_CODE=
GST_INVOICE_AUTHORISED_SIGNATORY=
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
